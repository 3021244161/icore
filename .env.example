# =============================================================================
# icore — Example environment configuration
# =============================================================================
# Copy to `.env` and fill in real values. All settings can also be set
# directly as environment variables (ICORE_* prefix). See icore/config.py
# for the full schema. YAML config files (config/*.yaml) may reference
# these via ${VAR} placeholders.
# =============================================================================

# --- Application ---
ICORE_DEBUG=false
# ICORE_CONFIG_DIR=./config

# --- API server (ICORE_API_*) ---
ICORE_API_HOST=0.0.0.0
ICORE_API_PORT=8000
ICORE_API_WORKERS=1
# ICORE_API_CORS_ORIGINS=["*"]

# --- Concurrency (ICORE_CONCURRENCY_*) ---
ICORE_CONCURRENCY_MAX_CONCURRENT_TASKS=100
ICORE_CONCURRENCY_MAX_CONCURRENT_PER_WORKFLOW=20
ICORE_CONCURRENCY_TASK_QUEUE_BACKEND=memory
# ICORE_CONCURRENCY_REDIS_URL=redis://localhost:6379/0
ICORE_CONCURRENCY_TASK_TIMEOUT=600
ICORE_CONCURRENCY_BACKPRESSURE_THRESHOLD=500

# --- Logging (ICORE_LOG_*) ---
ICORE_LOG_LEVEL=INFO
# ICORE_LOG_DIR=./logs

# --- Workflow auto-registration ---
# Comma-separated module list imported at startup to populate registries.
ICORE_WORKFLOW_MODULES=icore.workflows.examples
ICORE_AUTOREGISTER_WORKFLOWS=true

# =============================================================================
# Secrets referenced by config/models.yaml and config/databases.yaml
# =============================================================================
OPENAI_API_KEY=sk-replace-me
DEEPSEEK_API_KEY=

# Database credentials (referenced by config/databases.yaml)
DB_USER=postgres
DB_PASSWORD=postgres
ORACLE_USER=
ORACLE_PASSWORD=
HIVE_USER=
HIVE_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=
